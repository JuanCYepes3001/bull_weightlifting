# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=BULL Weightlifting <noreply@yourdomain.com>

# ── WhatsApp (Twilio) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── PayPal ────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_MODE=sandbox

# ── Tipo de cambio COP → USD (PayPal) ─────────────────────────
COP_TO_USD_RATE=4200

# ── Métodos de pago manuales (mejoran UX en checkout) ─────────
NEXT_PUBLIC_NEQUI_NUMBER=
NEXT_PUBLIC_DAVIPLATA_NUMBER=
NEXT_PUBLIC_DOLLAR_APP_USER=
NEXT_PUBLIC_GLOBAL66_ACCOUNT=
NEXT_PUBLIC_WHATSAPP_NUMBER=
