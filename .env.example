# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=BULL Weightlifting <noreply@yourdomain.com>

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────
# Guía completa: docs/whatsapp-templates.md
# Token permanente de un System User con permiso whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Manager → Teléfonos → Identificador del número (no es el número)
WHATSAPP_PHONE_NUMBER_ID=
# Idioma con el que se aprobaron las plantillas
WHATSAPP_TEMPLATE_LANG=es

# ── PayPal ────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_MODE=sandbox

# ── Wompi (tarjeta / PSE / Nequi) ─────────────────────────────
# comercios.wompi.co → Desarrolladores. Llaves pub_test_/prv_test_ = sandbox,
# pub_prod_/prv_prod_ = dinero real. Los 4 valores deben ser del mismo ambiente.
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# ── Cron (Vercel lo envía como "Authorization: Bearer ...") ───
CRON_SECRET=una-cadena-larga-aleatoria

# ── Tipo de cambio COP → USD (PayPal) ─────────────────────────
COP_TO_USD_RATE=4200

# ── Métodos de pago manuales (mejoran UX en checkout) ─────────
NEXT_PUBLIC_NEQUI_NUMBER=
NEXT_PUBLIC_DAVIPLATA_NUMBER=
NEXT_PUBLIC_DOLLAR_APP_USER=
NEXT_PUBLIC_GLOBAL66_ACCOUNT=
NEXT_PUBLIC_WHATSAPP_NUMBER=
